</main>
<footer class="footer">
    <div class="footer-container">
        <div class="footer-column brand-col">
            <h3 class="footer-logo">TAJMAHAL PRODUCTS</h3>
            <p>Manufacturer & Exporter of Luxury Handcrafted Carpets. Six Generations of Heritage Craftsmanship. Defined
                by Excellence.</p>
            <div class="social-links">
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-pinterest"></i></a>
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
            </div>
        </div>
        <div class="footer-column">
            <h4>Explore</h4>
            <ul class="footer-links">
                <li><a href="/about">Our Heritage</a></li>
                <li><a href="/products">Collections</a></li>
                <li><a href="/craftsmanship">Craftsmanship</a></li>
                <li><a href="/contact">Contact Us</a></li>
            </ul>
        </div>
        <div class="footer-column">
            <h4>Contact</h4>
            <address class="footer-address">
                <%= (settings.contact_address || '' ).replace(/\n/g, '<br>' ) %>
            </address>
            <p class="footer-contact"><a href="mailto:<%= settings.contact_email %>"><i class="fas fa-envelope"></i>
                    <%= settings.contact_email %>
                </a></p>
            <% if (settings.contact_phone1) { %>
                <p class="footer-contact"><i class="fas fa-phone-alt"></i>
                    <%= settings.contact_phone1 %>
                </p>
                <% } %>
                    <% if (settings.contact_phone2) { %>
                        <p class="footer-contact"><i class="fas fa-mobile-alt"></i>
                            <%= settings.contact_phone2 %>
                        </p>
                        <% } %>
        </div>
    </div>
    <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> Tajmahal Products. All rights reserved.</p>
        <p><a href="/admin">Admin Login</a></p>
    </div>
</footer>
<script src="/js/main.js"></script>
