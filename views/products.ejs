<%- include('partials/header') %>

    <section class="page-header">
        <div class="container text-center">
            <h1 class="page-title fade-up">Collections</h1>
            <div class="breadcrumbs fade-up delay-1">
                <a href="/">Home</a> <span>/</span> Collections
            </div>
        </div>
    </section>

    <section class="products-section section-padding">
        <div class="container">
            <!-- Category Filter -->
            <div class="filter-container text-center mb-5">
                <button class="filter-btn active" data-filter="all">All</button>
                <button class="filter-btn" data-filter="Hand-Knotted">Hand-Knotted</button>
                <button class="filter-btn" data-filter="Hand-Tufted">Hand-Tufted</button>
                <button class="filter-btn" data-filter="Contemporary">Contemporary</button>
                <button class="filter-btn" data-filter="Traditional">Traditional</button>
                <button class="filter-btn" data-filter="Bespoke">Bespoke</button>
            </div>

            <div class="collection-grid" id="productGrid">
                <% if (carpets && carpets.length> 0) { %>
                    <% carpets.forEach(carpet=> { %>
                        <div class="carpet-card product-item" data-category="<%= carpet.category %>">
                            <div class="carpet-image">
                                <% if (carpet.imageUrl && carpet.imageUrl !=="" ) { %>
                                    <img src="<%= carpet.imageUrl %>" alt="<%= carpet.name %>">
                                    <% } else { %>
                                        <div class="img-placeholder">
                                            <i class="fas fa-image"></i>
                                            <span>Image Pending</span>
                                        </div>
                                        <% } %>
                                            <div class="carpet-overlay">
                                                <div class="carpet-details">
                                                    <h3
                                                        style="font-family:var(--font-heading);font-style:italic;color:#fff;font-size:1.2rem;margin-bottom:0.6rem;">
                                                        <%= carpet.name %>
                                                    </h3>
                                                    <div
                                                        style="display:grid;grid-template-columns:1fr 1fr;gap:0.3rem 1rem;text-align:left;font-size:0.78rem;margin-bottom:0.6rem;">
                                                        <% if (carpet.knots) { %>
                                                            <span><span
                                                                    style="color:var(--color-gold-light);font-family:var(--font-display);font-size:0.65rem;letter-spacing:1px;display:block;">KNOTS</span>
                                                                <%= carpet.knots %>
                                                            </span>
                                                            <% } %>
                                                                <% if (carpet.face) { %>
                                                                    <span><span
                                                                            style="color:var(--color-gold-light);font-family:var(--font-display);font-size:0.65rem;letter-spacing:1px;display:block;">FACE</span>
                                                                        <%= carpet.face %>
                                                                    </span>
                                                                    <% } %>
                                                                        <% if (carpet.washing) { %>
                                                                            <span><span
                                                                                    style="color:var(--color-gold-light);font-family:var(--font-display);font-size:0.65rem;letter-spacing:1px;display:block;">WASHING</span>
                                                                                <%= carpet.washing %>
                                                                            </span>
                                                                            <% } %>
                                                                                <% if (carpet.material) { %>
                                                                                    <span><span
                                                                                            style="color:var(--color-gold-light);font-family:var(--font-display);font-size:0.65rem;letter-spacing:1px;display:block;">MATERIAL</span>
                                                                                        <%= carpet.material %>
                                                                                    </span>
                                                                                    <% } %>
                                                    </div>
                                                    <% if (carpet.sizes && carpet.sizes.length> 0) { %>
                                                        <div style="margin-bottom:0.6rem;">
                                                            <span
                                                                style="color:var(--color-gold-light);font-family:var(--font-display);font-size:0.65rem;letter-spacing:1px;display:block;margin-bottom:0.3rem;">SIZES</span>
                                                            <div style="display:flex;flex-wrap:wrap;gap:0.25rem;">
                                                                <% carpet.sizes.forEach(s=> { %>
                                                                    <span
                                                                        style="background:rgba(196,151,59,0.2);border:1px solid rgba(196,151,59,0.4);padding:0.15rem 0.45rem;font-size:0.7rem;border-radius:1px;color:#f5ede0;">
                                                                        <%= s %>
                                                                    </span>
                                                                    <% }) %>
                                                            </div>
                                                        </div>
                                                        <% } %>
                                                            <% if (carpet.description) { %>
                                                                <p class="small-desc" style="font-size:0.8rem;">
                                                                    <%= carpet.description.substring(0, 90) %>
                                                                        <%= carpet.description.length> 90 ? '…' : '' %>
                                                                </p>
                                                                <% } %>
                                                </div>
                                            </div>
                            </div>
                            <div class="carpet-info">
                                <span class="carpet-category">
                                    <%= carpet.category %>
                                </span>
                                <h3 class="carpet-title">
                                    <%= carpet.name %>
                                </h3>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="empty-state text-center" style="grid-column: 1 / -1; padding: 4rem 0;">
                                    <i class="fas fa-box-open"
                                        style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                                    <h2>No Collections Available</h2>
                                    <p>Our catalog is currently being updated. Please check back later.</p>
                                    <p class="mt-2"><a href="/admin" class="btn btn-outline btn-small">Admin: Add
                                            Carpets</a></p>
                                </div>
                                <% } %>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>