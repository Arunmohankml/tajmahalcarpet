<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Tajmahal Products</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Cinzel:wght@400;600&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: #f4f1eb;
            font-family: 'Inter', sans-serif;
        }

        .admin-nav {
            background: var(--color-dark);
            border-bottom: 2px solid var(--color-gold);
            padding: 0.9rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .admin-nav-logo {
            font-family: 'Cinzel', serif;
            font-size: 1rem;
            letter-spacing: 3px;
            color: var(--color-champagne, #f5ede0);
        }

        .admin-nav-logo span {
            color: var(--color-gold);
            margin-left: 8px;
            font-size: 0.72rem;
        }

        .admin-nav a {
            color: rgba(245, 237, 224, 0.7);
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .admin-nav a:hover {
            color: var(--color-gold);
        }

        .admin-layout {
            max-width: 1300px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .admin-page-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-style: italic;
            color: var(--color-dark);
            margin-bottom: 0.25rem;
        }

        .admin-subtitle {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        /* Tabs */
        .admin-tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid var(--color-border, #d9c9a8);
            margin-bottom: 2rem;
        }

        .admin-tab {
            padding: 0.75rem 1.75rem;
            font-family: 'Cinzel', serif;
            font-size: 0.72rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            border: none;
            background: none;
            color: #888;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            transition: all 0.2s;
        }

        .admin-tab.active {
            color: var(--color-dark);
            border-bottom-color: var(--color-gold);
        }

        .admin-tab:hover {
            color: var(--color-gold);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Cards */
        .admin-card {
            background: #fff;
            padding: 2rem;
            border-radius: 4px;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--color-border, #d9c9a8);
            margin-bottom: 2rem;
        }

        .admin-card h3 {
            font-family: 'Cinzel', serif;
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--color-dark);
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--color-border, #d9c9a8);
        }

        /* Two-col layout */
        .admin-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2rem;
        }

        @media (max-width: 900px) {
            .admin-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Form styles */
        .form-group {
            margin-bottom: 1.2rem;
        }

        .form-group label {
            display: block;
            font-size: 0.72rem;
            font-family: 'Cinzel', serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #666;
            margin-bottom: 0.4rem;
            font-weight: 600;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.75rem 0.9rem;
            border: 1px solid #ddd;
            border-radius: 2px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            background: #faf9f6;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--color-gold);
            box-shadow: 0 0 0 3px rgba(196, 151, 59, 0.1);
            background: #fff;
        }

        .form-group small {
            display: block;
            margin-top: 0.35rem;
            color: #999;
            font-size: 0.78rem;
        }

        /* Checkboxes for sizes */
        .checkbox-group {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.4rem;
            margin-top: 0.25rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            cursor: pointer;
            padding: 0.4rem 0.6rem;
            border: 1px solid #eee;
            border-radius: 2px;
            transition: all 0.2s;
        }

        .checkbox-label:hover {
            border-color: var(--color-gold);
            background: #fffdf5;
        }

        .checkbox-label input[type="checkbox"] {
            width: auto;
            accent-color: var(--color-gold);
        }

        .section-label {
            font-family: 'Cinzel', serif;
            font-size: 0.68rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--color-gold, #c4973b);
            margin: 1.2rem 0 0.6rem;
            padding-bottom: 0.3rem;
            border-bottom: 1px dashed #e0d8c8;
        }

        /* Image preview */
        .img-preview-box {
            width: 100%;
            height: 160px;
            border: 1px dashed #ccc;
            border-radius: 2px;
            background: #fafafa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .img-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Table */
        .table-admin {
            width: 100%;
            border-collapse: collapse;
        }

        .table-admin th,
        .table-admin td {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid #f0ebe0;
            text-align: left;
            font-size: 0.88rem;
        }

        .table-admin th {
            background: #faf8f4;
            font-family: 'Cinzel', serif;
            font-size: 0.68rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #666;
            font-weight: 600;
        }

        .table-admin img {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 2px;
            border: 1px solid #eee;
        }

        .table-admin tr:hover td {
            background: #fdfcf8;
        }

        .badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            background: #f0ebe0;
            border-radius: 2px;
            font-size: 0.72rem;
            color: #666;
            font-family: 'Cinzel', serif;
            letter-spacing: 0.5px;
        }

        .badge-gold {
            background: rgba(196, 151, 59, 0.12);
            color: var(--color-gold, #c4973b);
        }

        /* Buttons */
        .btn-admin-primary {
            width: 100%;
            padding: 0.9rem;
            background: linear-gradient(135deg, #9a7320, var(--color-gold, #c4973b));
            color: var(--color-dark, #0f0a04);
            border: none;
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
            border-radius: 2px;
            margin-top: 0.5rem;
        }

        .btn-admin-primary:hover {
            opacity: 0.88;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(196, 151, 59, 0.3);
        }

        .btn-danger {
            padding: 0.4rem 0.9rem;
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
            border-radius: 2px;
            font-size: 0.78rem;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
        }

        .btn-danger:hover {
            background: #b91c1c;
            color: white;
        }

        .btn-settings-save {
            padding: 0.8rem 2.5rem;
            background: var(--color-dark, #0f0a04);
            color: #f5ede0;
            border: none;
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
            border-radius: 2px;
        }

        .btn-settings-save:hover {
            background: var(--color-gold, #c4973b);
            color: var(--color-dark);
        }

        /* Settings image grid */
        .settings-img-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 600px) {
            .settings-img-grid {
                grid-template-columns: 1fr;
            }
        }

        .settings-img-item {
            position: relative;
        }

        .settings-img-preview {
            width: 100%;
            height: 110px;
            object-fit: cover;
            border-radius: 2px;
            border: 1px solid #ddd;
            background: #f0ebe0;
            display: block;
            margin-bottom: 0.4rem;
        }

        /* Success toast */
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: var(--color-dark);
            color: var(--color-gold, #c4973b);
            padding: 1rem 1.5rem;
            border-radius: 2px;
            font-family: 'Cinzel', serif;
            font-size: 0.78rem;
            letter-spacing: 1px;
            border-left: 3px solid var(--color-gold, #c4973b);
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.4s ease;
            z-index: 9999;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #aaa;
            font-size: 0.9rem;
        }

        .empty-state i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: block;
            opacity: 0.3;
        }
    </style>
</head>

<body>

    <nav class="admin-nav">
        <div class="admin-nav-logo">TAJMAHAL PRODUCTS <span>ADMIN</span></div>
        <a href="/"><i class="fas fa-globe" style="margin-right:6px;"></i>View Website</a>
    </nav>

    <div class="admin-layout">
        <div style="margin-bottom: 1.5rem;">
            <h1 class="admin-page-title">Admin Dashboard</h1>
            <p class="admin-subtitle">Manage your carpet catalog and website settings without touching any code.</p>
        </div>

        <!-- Tabs -->
        <div class="admin-tabs">
            <button class="admin-tab active" onclick="switchTab('catalog')"><i class="fas fa-th-large"
                    style="margin-right:6px;"></i>Catalog</button>
            <button class="admin-tab" onclick="switchTab('settings')"><i class="fas fa-images"
                    style="margin-right:6px;"></i>Site Images</button>
        </div>

        <!-- ════ TAB: CATALOG ════ -->
        <div id="tab-catalog" class="tab-content active">
            <div class="admin-grid">

                <!-- LEFT: Add Carpet Form -->
                <div class="admin-card">
                    <h3><i class="fas fa-plus" style="margin-right:8px; color:var(--color-gold);"></i>Add New Carpet
                    </h3>
                    <form action="/api/carpets" method="POST">

                        <div class="section-label">Basic Info</div>

                        <div class="form-group">
                            <label for="name">Carpet Name *</label>
                            <input type="text" id="name" name="name" required placeholder="e.g. Royal Persian Silk">
                        </div>
                        <div class="form-group">
                            <label for="category">Category *</label>
                            <select id="category" name="category" required>
                                <option value="Hand-Knotted">Hand-Knotted</option>
                                <option value="Hand-Tufted">Hand-Tufted</option>
                                <option value="Contemporary">Contemporary</option>
                                <option value="Traditional">Traditional</option>
                                <option value="Bespoke">Bespoke</option>
                            </select>
                        </div>

                        <div class="section-label">Specifications</div>

                        <div class="form-group">
                            <label for="knots">Knots (per sq. inch / KPSI)</label>
                            <input type="text" id="knots" name="knots" placeholder="e.g. 100, 150, 200 KPSI">
                            <small>Knots per square inch — quality indicator</small>
                        </div>
                        <div class="form-group">
                            <label for="face">Face / Pile</label>
                            <select id="face" name="face">
                                <option value="">— Select Face Type —</option>
                                <option value="Cut Pile">Cut Pile</option>
                                <option value="Loop Pile">Loop Pile</option>
                                <option value="Cut & Loop">Cut & Loop</option>
                                <option value="Flat Weave">Flat Weave</option>
                                <option value="Shaggy / High Pile">Shaggy / High Pile</option>
                                <option value="Velvet Pile">Velvet Pile</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="washing">Washing / Finishing</label>
                            <select id="washing" name="washing">
                                <option value="">— Select Washing Type —</option>
                                <option value="Stone Washed">Stone Washed</option>
                                <option value="Chemical Washed">Chemical Washed</option>
                                <option value="Tea Washed">Tea Washed</option>
                                <option value="Luster Washed">Luster Washed</option>
                                <option value="Hand Washed">Hand Washed</option>
                                <option value="Antique Washed">Antique Washed</option>
                                <option value="Dry Finished">Dry Finished (No Wash)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="material">Material</label>
                            <input type="text" id="material" name="material" placeholder="e.g. Wool & Silk, Pure Wool">
                        </div>
                        <div class="form-group">
                            <label for="origin">Origin</label>
                            <input type="text" id="origin" name="origin" value="Bhadohi, India">
                        </div>

                        <div class="section-label">Sizes Available</div>
                        <div class="form-group">
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="All European & American Sizes"> All EU
                                    &amp; US Sizes
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="2x3 ft"> 2×3 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="4x6 ft"> 4×6 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="5x8 ft"> 5×8 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="6x9 ft"> 6×9 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="8x10 ft"> 8×10 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="9x12 ft"> 9×12 ft
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="sizes" value="Custom Size"> Custom Size
                                </label>
                            </div>
                        </div>

                        <div class="section-label">Image & Description</div>

                        <div class="form-group">
                            <label for="imageUrl">Image URL</label>
                            <input type="text" id="imageUrl" name="imageUrl" placeholder="Paste direct image link"
                                oninput="updatePreview(this.value)">
                            <small>Paste a direct image link from Imgur, Google Drive, Unsplash, etc.</small>
                        </div>
                        <div class="img-preview-box" id="imgPreviewBox">
                            <img id="imgPreview" src="" alt=""
                                style="display:none; width:100%; height:100%; object-fit:cover;">
                            <span id="imgText" style="color:#bbb; font-size:0.85rem;"><i class="fas fa-image"
                                    style="margin-right:6px;"></i>Image Preview</span>
                        </div>

                        <div class="form-group" style="margin-top:1rem;">
                            <label for="description">Short Description</label>
                            <textarea id="description" name="description" rows="3"
                                placeholder="Brief details about this carpet..."></textarea>
                        </div>

                        <button type="submit" class="btn-admin-primary"><i class="fas fa-save"
                                style="margin-right:8px;"></i>Save to Catalog</button>
                    </form>
                </div>

                <!-- RIGHT: Carpet Table -->
                <div class="admin-card">
                    <h3><i class="fas fa-list" style="margin-right:8px; color:var(--color-gold);"></i>Current Catalog
                        <span style="font-size:0.85rem; color:#aaa; letter-spacing:0;">(<%= carpets.length %>
                                items)</span>
                    </h3>
                    <div style="overflow-x: auto;">
                        <table class="table-admin">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Knots</th>
                                    <th>Washing</th>
                                    <th>Sizes</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (carpets && carpets.length> 0) { %>
                                    <% carpets.forEach(carpet=> { %>
                                        <tr>
                                            <td>
                                                <% if (carpet.imageUrl) { %>
                                                    <img src="<%= carpet.imageUrl %>" alt="<%= carpet.name %>">
                                                    <% } else { %>
                                                        <div
                                                            style="width:52px;height:52px;background:#f0ebe0;display:flex;align-items:center;justify-content:center;border-radius:2px;font-size:10px;color:#aaa;text-align:center;">
                                                            No<br>Img</div>
                                                        <% } %>
                                            </td>
                                            <td><strong style="font-family:'Cormorant Garamond',serif;font-size:1rem;">
                                                    <%= carpet.name %>
                                                </strong><br>
                                                <span style="font-size:0.78rem;color:#999;">
                                                    <%= carpet.material || '' %>
                                                </span>
                                            </td>
                                            <td><span class="badge">
                                                    <%= carpet.category %>
                                                </span></td>
                                            <td><span style="font-size:0.82rem;color:#666;">
                                                    <%= carpet.knots || '—' %>
                                                </span></td>
                                            <td><span style="font-size:0.82rem;color:#666;">
                                                    <%= carpet.washing || '—' %>
                                                </span></td>
                                            <td>
                                                <% if (carpet.sizes && carpet.sizes.length> 0) { %>
                                                    <% carpet.sizes.slice(0,2).forEach(s=> { %>
                                                        <span class="badge badge-gold" style="margin:1px;">
                                                            <%= s %>
                                                        </span>
                                                        <% }) %>
                                                            <% if (carpet.sizes.length> 2) { %><span
                                                                    style="font-size:0.75rem;color:#aaa;">+<%=
                                                                        carpet.sizes.length - 2 %></span>
                                                                <% } %>
                                                                    <% } else { %>
                                                                        <span style="color:#ccc;">—</span>
                                                                        <% } %>
                                            </td>
                                            <td>
                                                <form action="/api/carpets/delete/<%= carpet.id %>" method="POST"
                                                    onsubmit="return confirm('Delete this carpet?');">
                                                    <button type="submit" class="btn-danger"><i
                                                            class="fas fa-trash"></i> Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7">
                                                        <div class="empty-state">
                                                            <i class="fas fa-box-open"></i>
                                                            No carpets in catalog yet. Add one from the left panel.
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <!-- ════ TAB: SITE IMAGES ════ -->
        <div id="tab-settings" class="tab-content">
            <form action="/api/settings" method="POST">
                <div class="admin-card">
                    <h3><i class="fas fa-images" style="margin-right:8px;color:var(--color-gold);"></i>Heritage & About
                        Page Images</h3>
                    <p style="color:#888;font-size:0.88rem;margin-bottom:1.5rem;">These images appear on the Heritage
                        and Philosophy sections of the website. Paste any direct image URL (Imgur, Google Drive public
                        link, Unsplash, your own server, etc.)</p>

                    <div class="settings-img-grid">
                        <div class="settings-img-item">
                            <label class="form-group">
                                <span
                                    style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;display:block;margin-bottom:0.4rem;">Heritage
                                    Story Image</span>
                                <input type="text" name="img_heritage" value="<%= settings.img_heritage %>"
                                    placeholder="Direct image URL..."
                                    oninput="updateSettingsPreview(this, 'prev_heritage')">
                            </label>
                            <img id="prev_heritage" class="settings-img-preview" src="<%= settings.img_heritage %>"
                                alt="">
                        </div>
                        <div class="settings-img-item">
                            <label class="form-group">
                                <span
                                    style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;display:block;margin-bottom:0.4rem;">Weaving
                                    / Philosophy Image</span>
                                <input type="text" name="img_weaving" value="<%= settings.img_weaving %>"
                                    placeholder="Direct image URL..."
                                    oninput="updateSettingsPreview(this, 'prev_weaving')">
                            </label>
                            <img id="prev_weaving" class="settings-img-preview" src="<%= settings.img_weaving %>"
                                alt="">
                        </div>
                        <div class="settings-img-item">
                            <label class="form-group">
                                <span
                                    style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;display:block;margin-bottom:0.4rem;">Sustainability
                                    / Ethical Image</span>
                                <input type="text" name="img_sustainable" value="<%= settings.img_sustainable %>"
                                    placeholder="Direct image URL..."
                                    oninput="updateSettingsPreview(this, 'prev_sustainable')">
                            </label>
                            <img id="prev_sustainable" class="settings-img-preview"
                                src="<%= settings.img_sustainable %>" alt="">
                        </div>
                    </div>
                </div>

                <div class="admin-card">
                    <h3><i class="fas fa-industry" style="margin-right:8px;color:var(--color-gold);"></i>Factory /
                        Craftsmanship Gallery</h3>
                    <p style="color:#888;font-size:0.88rem;margin-bottom:1.5rem;">These images appear in the Factory
                        Gallery section on the Craftsmanship page. Add your own factory photos here — no code needed!
                    </p>

                    <div class="settings-img-grid">
                        <% [1,2,3,4].forEach(n=> { %>
                            <div class="settings-img-item">
                                <label class="form-group">
                                    <span
                                        style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;display:block;margin-bottom:0.4rem;">Factory
                                        Photo <%= n %></span>
                                    <input type="text" name="img_factory<%= n %>"
                                        value="<%= settings['img_factory'+n] || '' %>"
                                        placeholder="Paste direct image URL..."
                                        oninput="updateSettingsPreview(this, 'prev_factory<%= n %>')">
                                </label>
                                <% if (settings['img_factory'+n]) { %>
                                    <img id="prev_factory<%= n %>" class="settings-img-preview"
                                        src="<%= settings['img_factory'+n] %>" alt="">
                                    <% } else { %>
                                        <div id="prev_factory<%= n %>" class="settings-img-preview"
                                            style="display:flex;align-items:center;justify-content:center;color:#ccc;flex-direction:column;gap:0.5rem;">
                                            <i class="fas fa-camera" style="font-size:1.5rem;"></i>
                                            <span style="font-size:0.78rem;">No image yet</span>
                                        </div>
                                        <% } %>
                            </div>
                            <% }) %>
                    </div>
                </div>


                <div class="admin-card">
                    <h3><i class="fas fa-address-book" style="margin-right:8px;color:var(--color-gold);"></i>Contact
                        Information</h3>
                    <p style="color:#888;font-size:0.88rem;margin-bottom:1.5rem;">Update the address, phone numbers, and
                        email shown on the Contact page and website footer.</p>

                    <div class="form-group">
                        <label
                            style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;">Business
                            Address</label>
                        <textarea name="contact_address" rows="3"
                            style="width:100%;padding:0.75rem;border:1px solid #ddd;font-family:'Inter',sans-serif;font-size:0.9rem;border-radius:2px;background:#faf9f6;resize:vertical;"><%= settings.contact_address %></textarea>
                        <small style="color:#999;font-size:0.78rem;">Use line breaks to separate address lines.</small>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                        <div class="form-group">
                            <label
                                style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;">Phone
                                / Landline</label>
                            <input type="text" name="contact_phone1" value="<%= settings.contact_phone1 %>"
                                placeholder="+91 XXXXXXXXXX">
                        </div>
                        <div class="form-group">
                            <label
                                style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;">Mobile
                                / Alternate</label>
                            <input type="text" name="contact_phone2" value="<%= settings.contact_phone2 %>"
                                placeholder="+91 XXXXXXXXXX">
                        </div>
                    </div>

                    <div class="form-group">
                        <label
                            style="font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:1px;text-transform:uppercase;color:#666;">Email
                            Address</label>
                        <input type="email" name="contact_email" value="<%= settings.contact_email %>"
                            placeholder="your@email.com">
                    </div>
                </div>

                <div style="text-align:right; margin-bottom: 3rem;">
                    <button type="submit" class="btn-settings-save"><i class="fas fa-save"
                            style="margin-right:8px;"></i>Save All Settings</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast" id="toast"><i class="fas fa-check-circle" style="margin-right:8px;"></i>Settings saved
        successfully!</div>

    <script>
        // Tab switching
        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.admin-tab').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            event.target.classList.add('active');
        }

        // Carpet image preview
        function updatePreview(url) {
            const img = document.getElementById('imgPreview');
            const text = document.getElementById('imgText');
            if (url) {
                img.src = url;
                img.style.display = 'block';
                text.style.display = 'none';
            } else {
                img.style.display = 'none';
                text.style.display = 'block';
            }
        }

        // Settings image preview
        function updateSettingsPreview(input, previewId) {
            const el = document.getElementById(previewId);
            if (!el) return;
            if (input.value) {
                if (el.tagName !== 'IMG') {
                    const img = document.createElement('img');
                    img.id = previewId;
                    img.className = 'settings-img-preview';
                    el.replaceWith(img);
                    const newEl = document.getElementById(previewId);
                    newEl.src = input.value;
                } else {
                    el.src = input.value;
                }
            }
        }

        // Show toast if saved
        const params = new URLSearchParams(window.location.search);
        if (params.get('saved') === '1') {
            const toast = document.getElementById('toast');
            toast.classList.add('show');
            // Switch to settings tab if coming from settings save
            switchTab('settings');
            setTimeout(() => toast.classList.remove('show'), 4000);
        }
    </script>
</body>

</html>