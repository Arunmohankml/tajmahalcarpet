<%- include('partials/header') %>

    <section class="page-header">
        <div class="container text-center">
            <h1 class="page-title fade-up">Craftsmanship</h1>
            <div class="breadcrumbs fade-up delay-1">
                <a href="/">Home</a> <span>/</span> Craftsmanship
            </div>
        </div>
    </section>

    <section class="process-section section-padding">
        <div class="container">
            <div class="section-header text-center w-max-800">
                <span class="accent-text">The Making</span>
                <h2 class="section-heading">Artisanal Process</h2>
                <p>Manufactured in Bhadohi, India, our carpets are woven by skilled artisans with decades of experience.
                    Our production emphasizes small-batch precision over mass output.</p>
            </div>

            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-icon"><i class="fas fa-sheep"></i></div>
                    <div class="timeline-content">
                        <h3>Material Selection</h3>
                        <p>We source only premium wool, silk, and bespoke natural blends to assure a foundation of
                            exceptional longevity and texture.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-icon"><i class="fas fa-palette"></i></div>
                    <div class="timeline-content">
                        <h3>Dyeing</h3>
                        <p>Controlled dyeing processes fix rich, deep colors that resist fading and carry true vibrancy
                            across each strand of yarn.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-icon"><i class="fas fa-hands"></i></div>
                    <div class="timeline-content">
                        <h3>Weaving</h3>
                        <p>Master weavers utilize traditional knotting techniques, including Nepal knotting,
                            meticulously working on looms to bring intricate designs to life.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-icon"><i class="fas fa-cut"></i></div>
                    <div class="timeline-content">
                        <h3>Finishing</h3>
                        <p>Every stage—from washing to clipping and binding—is monitored to ensure consistency,
                            structural integrity, and visual excellence.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sustainability section-padding bg-light">
        <div class="container section-grid align-items-center">
            <div class="section-text">
                <span class="accent-text">Our Commitment</span>
                <h2 class="section-heading">Ethical & Sustainable</h2>
                <ul class="feature-list">
                    <li><i class="fas fa-check text-gold"></i> Preservation of artisanal skills through fair employment
                    </li>
                    <li><i class="fas fa-check text-gold"></i> Responsible sourcing of materials</li>
                    <li><i class="fas fa-check text-gold"></i> Controlled dyeing and finishing processes with minimal
                        environmental impact</li>
                    <li><i class="fas fa-check text-gold"></i> Long-term and supportive partnerships with weaving
                        communities in Bhadohi</li>
                </ul>
            </div>
            <div class="section-image image-placeholder">
                <div class="img-inner bg-sustainable"></div>
            </div>
        </div>
    </section>

    <section class="global-presence section-padding text-center">
        <div class="container">
            <h2 class="section-heading mb-4">Global Presence</h2>
            <p class="lead-text w-max-800 mx-auto mb-5">Our exports serve select markets in Europe, North America, the
                Middle East, and Asia-Pacific. We partner with:</p>

            <div class="features-grid">
                <div class="feature-box">
                    <i class="fas fa-couch feature-icon"></i>
                    <h3>Designers</h3>
                    <p>Luxury interior designers bringing bespoke visions to life.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-store feature-icon"></i>
                    <h3>Retailers</h3>
                    <p>High-end retailers and exclusive galleries curating the finest pieces.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-building feature-icon"></i>
                    <h3>Projects</h3>
                    <p>Hospitality and residential project specialists seeking superior quality.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-tag feature-icon"></i>
                    <h3>Brands</h3>
                    <p>Private-label and boutique brands relying on our manufacturing discretion.</p>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>